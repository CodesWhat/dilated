#!/bin/bash
# Runs the two pmset commands Dilated needs for closed-lid mode, through the sudoers rule that
# Dilated Closed-Lid Setup installs, and owns the session record that lets a LaunchAgent revert
# them when the app is gone. The Mac App Store build can't spawn sudo, so it runs this script from
# ~/Library/Application Scripts/<bundle id>/ through NSUserUnixTask.
#
# Usage: dilated-power on <pid> | beat | off | check | repair | probe | begin-removal | finish-removal
# Output: one word on stdout, then the exit status.
#   ok        0   the command ran (or, for probe, sudo allows both commands)
#   reverted  4   (on) the agent already reverted this pid's session; enable again to continue
#   norule    3   sudo needs a password, doesn't allow the command, or the user may not run sudo
#   noagent   3   (on, probe) the repair LaunchAgent isn't loaded, or the companion is removing it.
#                 Shares norule's exit status on purpose: an app that predates this word reads an
#                 unknown first word as a failed command and refuses the enable, so nothing turns
#                 sleep off without the agent that can turn it back on. Run the setup companion again.
#   failed    N   anything else; N is the failing command's status, or 1
#   none      0   (beat, check) there is no session
#   live | dead | stale | reverted   (check) what `repair` would see; nothing is changed
#   busy      1   (on, probe) the lock stayed taken for about a second; any word but ok is a refusal to build 18
#   begin-removal (companion only) takes the lock, writes the removal marker and, only when a session
#                 file exists, latches "restore pending" and turns sleep back on (ok; none when
#                 nothing was ours). The session stays. The latch survives off and repair, so a
#                 retry after they deleted the session still answers ok and needs the readback.
#   finish-removal (companion only) deletes the session, tombstone and latch once the companion has
#                 seen sleep read back normal.
#                 While the marker exists `on` and `probe` answer noagent; off and repair still work.
#                 The marker outlives a removal; installing the companion again clears it once the
#                 agent is loaded.
# Anything but a valid verb with its exact arguments prints usage to stderr and exits 64.
#
# Session record: $HOME/Library/Application Support/dilated-power/session holds
# `<pid> <ps lstart>`; its mtime is the heartbeat. `repair` (run every 30s by the
# com.codeswhat.dilated.closed-lid-repair LaunchAgent) reverts when the pid is gone, its start time
# differs, or the heartbeat is older than 120s while kern.waketime is too (a hung app, not a sleeping Mac).
set -euo pipefail

usage() {
  echo "usage: dilated-power on <pid>|beat|off|check|repair|probe|begin-removal|finish-removal" >&2
  exit 64
}

verb=${1:-}
pid=""
case "$verb" in
  on)
    [ "$#" -eq 2 ] || usage
    pid=$2
    case "$pid" in
      '' | *[!0-9]*) usage ;;
    esac
    [ "${#pid}" -le 10 ] || usage
    pid=$((10#$pid))
    [ "$pid" -gt 0 ] || usage
    ;;
  beat | off | check | repair | probe | begin-removal | finish-removal) [ "$#" -eq 1 ] || usage ;;
  *) usage ;;
esac

# Test hooks. They are honored only when this file runs from a repo checkout
# (<repo>/packaging/mas next to Package.swift), never from the installed copy, so the environment
# of a NSUserUnixTask or a local shell can't redirect sudo or the wake time.
test_sudo=""
test_wake=""
test_launchctl=""
test_clock=""
test_sleepdisabled="__real__"
test_stored="__same__"
self=${BASH_SOURCE[0]}
case "$self" in
  */*) self_dir=${self%/*} ;;
  *) self_dir=. ;;
esac
if self_dir=$(cd "$self_dir" 2>/dev/null && pwd -P); then
  case "$self_dir" in
    */packaging/mas)
      if [ -f "$self_dir/../../Package.swift" ]; then
        test_sudo=${DILATED_POWER_TEST_SUDO:-}
        test_wake=${DILATED_POWER_TEST_WAKE:-}
        test_launchctl=${DILATED_POWER_TEST_LAUNCHCTL:-}
        test_clock=${DILATED_POWER_TEST_CLOCK:-}
        test_sleepdisabled=${DILATED_POWER_TEST_SLEEPDISABLED-__real__}
        test_stored=${DILATED_POWER_TEST_STORED_SLEEPDISABLED-__same__}
      fi
      ;;
  esac
fi

stale_after=120

# Mirrors SudoPowerRunner.lacksPermission: status 1 plus one of the three sudo messages.
report() {
  local status=$1 detail=$2
  if [ "$status" -eq 1 ]; then
    case "$detail" in
      *"a password is required"* | *"not allowed"* | *"may not run sudo"*)
        echo norule
        exit 3
        ;;
    esac
  fi
  echo failed
  exit "$status"
}

# Runs sudo with an empty environment. Arguments are fixed strings from this file.
run_sudo() {
  if [ -n "$test_sudo" ]; then
    "$test_sudo" "$@" 2>&1
    return
  fi
  /usr/bin/env -i /usr/bin/sudo -n "$@" 2>&1
}

home=${HOME:-}
case "$home" in
  /*) ;;
  *)
    echo failed
    exit 1
    ;;
esac
session_dir="$home/Library/Application Support/dilated-power"
session_file="$session_dir/session"
tombstone_file="$session_dir/tombstone"
lock_dir="$session_dir/lock.d"
# Written by begin-removal and cleared only by the companion's install. It outlives the script.
removal_file="$session_dir/removal"
# Written by begin-removal, under the lock and before pmset, when the session is ours. Unlike the
# removal marker it means sleep was ours to restore and the readback hasn't passed yet. Only
# finish-removal clears it, so off and repair deleting the session can't skip the readback.
restore_pending_file="$session_dir/restore-pending"
agent_label="com.codeswhat.dilated.closed-lid-repair"

# True when the repair LaunchAgent is loaded in this user's GUI domain. Without it nothing can
# turn sleep back on after a crash, so `on` and `probe` refuse.
# The app's task times out after 3 seconds, so launchctl gets one second: it runs in the background
# and is killed when it's still going (macOS has no timeout(1)). A timeout reads as not loaded.
agent_loaded() {
  local launchctl=${test_launchctl:-/bin/launchctl} job ticks=0
  "$launchctl" print "gui/$(/usr/bin/id -u)/$agent_label" >/dev/null 2>&1 &
  job=$!
  while /bin/kill -0 "$job" 2>/dev/null; do
    if [ "$ticks" -ge 10 ]; then
      /bin/kill -9 "$job" 2>/dev/null || true
      wait "$job" 2>/dev/null || true
      return 1
    fi
    ticks=$((ticks + 1))
    /bin/sleep 0.1
  done
  wait "$job"
}

refuse_unready() {
  echo noagent
  exit 3
}

ensure_dir() {
  (umask 077 && /bin/mkdir -p "$session_dir") && /bin/chmod 700 "$session_dir"
}

# Writes a 0600 file atomically: temp file in the same directory, then mv.
write_atomic() {
  local target=$1 content=$2 temp="$session_dir/.tmp.$$"
  (umask 077 && printf '%s\n' "$content" >"$temp") && /bin/mv -f "$temp" "$target"
}

have_lock=0
# Unique to this run, written into the lock directory it takes. A holder that outlived the steal
# window finds someone else's id (or none) there and leaves the new holder's lock alone.
lock_owner="$$.$RANDOM.$RANDOM"
# shellcheck disable=SC2329  # runs from the EXIT trap
release_lock() {
  local current_owner
  if [ "$have_lock" -eq 1 ]; then
    current_owner=""
    { read -r current_owner <"$lock_dir/owner"; } 2>/dev/null || true
    if [ "$current_owner" = "$lock_owner" ]; then
      /bin/rm -f "$lock_dir/owner"
      /bin/rmdir "$lock_dir" 2>/dev/null || true
    fi
    have_lock=0
  fi
}
trap release_lock EXIT

# Serializes the app's verbs and the agent's repair. A lock older than a minute is a crashed holder's.
# Waits up to $1 tenths of a second (default 5 seconds). $2, when given, also caps the wait in whole
# wall-clock seconds: each retry spawns processes, so under load the tries alone can run long.
# Whole seconds for the lock's wall-clock cap. The test hook scripts the clock, so a late
# acquisition can be tested without depending on how slow the machine is.
clock() {
  if [ -n "$test_clock" ]; then
    "$test_clock"
    return
  fi
  /bin/date +%s
}

# Takes a stale lock out of the way. The rename is atomic, so of several stealers only one gets the
# directory, and a holder that wakes up later can't remove what it no longer owns. If the directory
# moved turns out to be fresh (the lock was replaced between the staleness check and the rename),
# it goes back and the caller retries.
steal_lock() {
  local grave="$session_dir/lock.stale.$$" modified
  /bin/mv "$lock_dir" "$grave" 2>/dev/null || return 0
  modified=$(/usr/bin/stat -f %m "$grave" 2>/dev/null || echo 0)
  if [ $(($(clock) - modified)) -gt 60 ]; then
    /bin/rm -rf "$grave"
  else
    /bin/mv "$grave" "$lock_dir" 2>/dev/null || /bin/rm -rf "$grave"
  fi
}

take_lock() {
  local tries=0 modified now max=${1:-50} limit=${2:-} started
  ensure_dir || return 1
  started=$(clock)
  while ! (umask 077 && /bin/mkdir "$lock_dir" 2>/dev/null); do
    modified=$(/usr/bin/stat -f %m "$lock_dir" 2>/dev/null || echo 0)
    now=$(clock)
    if [ -n "$limit" ] && [ $((now - started)) -ge "$limit" ]; then
      return 1
    fi
    if [ $((now - modified)) -gt 60 ]; then
      steal_lock
      continue
    fi
    tries=$((tries + 1))
    [ "$tries" -le "$max" ] || return 1
    /bin/sleep 0.1
  done
  have_lock=1
  printf '%s\n' "$lock_owner" >"$lock_dir/owner" 2>/dev/null || true
  # A late acquisition doesn't get past the cap either: the caller has stopped waiting, and the
  # work that follows could outlive the app's timeout.
  if [ -n "$limit" ] && [ $(($(clock) - started)) -ge "$limit" ]; then
    release_lock
    return 1
  fi
}

# Start time of a live pid, empty when it's gone. The locale is pinned: lstart is localized, and
# the app's task and the LaunchAgent don't share an environment.
start_of() {
  { /usr/bin/env LC_ALL=C /bin/ps -o lstart= -p "$1" 2>/dev/null || true; } | /usr/bin/sed 's/^ *//; s/ *$//'
}

# Seconds since the last wake, or empty when it can't be read.
wake_age() {
  local raw wake
  if [ -n "$test_wake" ]; then
    raw="sec = $test_wake,"
  else
    raw=$(/usr/sbin/sysctl -n kern.waketime 2>/dev/null || true)
  fi
  if [[ $raw =~ sec[[:space:]]*=[[:space:]]*([0-9]+) ]]; then
    wake=${BASH_REMATCH[1]}
    echo $(($(/bin/date +%s) - wake))
  fi
}

# live | dead | stale | reverted | none. Reads only.
classify() {
  local record recorded_pid recorded_start modified age
  if [ ! -f "$session_file" ]; then
    if [ -f "$tombstone_file" ]; then echo reverted; else echo none; fi
    return
  fi
  record=$(<"$session_file") || record=""
  recorded_pid=${record%% *}
  recorded_start=${record#* }
  case "$recorded_pid" in
    '' | *[!0-9]*)
      echo dead
      return
      ;;
  esac
  if [ -z "$recorded_start" ] || [ "$(start_of "$recorded_pid")" != "$recorded_start" ]; then
    echo dead
    return
  fi
  modified=$(/usr/bin/stat -f %m "$session_file" 2>/dev/null || echo 0)
  if [ $(($(/bin/date +%s) - modified)) -gt "$stale_after" ]; then
    age=$(wake_age)
    if [ -n "$age" ] && [ "$age" -gt "$stale_after" ]; then
      echo stale
      return
    fi
  fi
  echo live
}

# The SleepDisabled value macOS reports now: 0, 1, or empty when it can't be read.
current_sleep_disabled() {
  if [ "$test_sleepdisabled" != "__real__" ]; then
    echo "$test_sleepdisabled"
    return
  fi
  /usr/bin/env -i /usr/bin/pmset -g 2>/dev/null | /usr/bin/awk '/SleepDisabled/ { print $2; exit }'
}

# The SleepDisabled value `pmset -a disablesleep` writes: 0, 1, or empty when it can't be read. It
# comes from the machine-wide power plist, the same store the app's readback checks.
stored_sleep_disabled() {
  if [ "$test_stored" != "__same__" ]; then
    echo "$test_stored"
    return
  fi
  if [ "$test_sleepdisabled" != "__real__" ]; then
    echo "$test_sleepdisabled"
    return
  fi
  case "$(/usr/bin/plutil -extract SystemPowerSettings.SleepDisabled raw -o - \
    /Library/Preferences/com.apple.PowerManagement.plist 2>/dev/null || true)" in
    true | 1) echo 1 ;;
    false | 0) echo 0 ;;
  esac
}

run_pmset() {
  local status=0 detail
  detail=$(run_sudo /usr/bin/pmset -a disablesleep "$1") || status=$?
  [ "$status" -eq 0 ] || report "$status" "$detail"
}

status=0
detail=""
case "$verb" in
  on)
    # The marker check comes before the lock, and the lock wait is capped (1s of tries, or 1 to 2
    # wall-clock seconds under load, plus 1s for launchctl below), so the verb stays inside the
    # app's 3 second timeout. `busy` isn't `ok`, so build 18 refuses the enable.
    [ ! -f "$removal_file" ] || refuse_unready
    take_lock 10 2 || {
      echo busy
      exit 1
    }
    # Under the lock, so a removal that held it first is always seen: its marker stays after it
    # finishes, and its agent is gone. Only then can pmset 1 run with a recovery agent in place.
    [ ! -f "$removal_file" ] || refuse_unready
    agent_loaded || refuse_unready
    if [ -f "$tombstone_file" ] && [ "$(<"$tombstone_file")" = "reverted $pid" ]; then
      /bin/rm -f "$tombstone_file"
      echo reverted
      exit 4
    fi
    start=$(start_of "$pid")
    if [ -z "$start" ]; then
      echo failed
      exit 1
    fi
    # The record goes down before sleep is disabled, so a crash in between leaves the agent a
    # session to revert. A failed enable removes it again.
    /bin/rm -f "$tombstone_file"
    write_atomic "$session_file" "$pid $start" || {
      echo failed
      exit 1
    }
    detail=$(run_sudo /usr/bin/pmset -a disablesleep 1) || status=$?
    if [ "$status" -ne 0 ]; then
      /bin/rm -f "$session_file"
      report "$status" "$detail"
    fi
    echo ok
    exit 0
    ;;
  beat)
    # Under the lock, so a beat can't land in the middle of repair or off; touch -c never creates
    # the file, so a session they just removed stays removed. A busy lock still gets the touch.
    [ -f "$session_file" ] || {
      echo none
      exit 0
    }
    take_lock || true
    /usr/bin/touch -c "$session_file" 2>/dev/null || true
    if [ -f "$session_file" ]; then echo ok; else echo none; fi
    exit 0
    ;;
  off)
    take_lock || {
      echo failed
      exit 1
    }
    run_pmset 0
    /bin/rm -f "$session_file" "$tombstone_file"
    echo ok
    exit 0
    ;;
  begin-removal)
    take_lock || {
      echo failed
      exit 1
    }
    # The marker goes down first, so a failed pmset still leaves new enables blocked.
    write_atomic "$removal_file" "removing" || {
      echo failed
      exit 1
    }
    # Sleep is restored only when this script owns it, which means a session file or the restore
    # latch and nothing else: a plain marker or a tombstone is a finished revert, and anything left
    # disabled after it is another app's. The latch goes down before pmset, so `off` or `repair`
    # deleting the session afterwards can't hide that the readback is still owed. With only the
    # latch left, whichever deleted the session already ran pmset 0, so it isn't run again.
    if [ -f "$session_file" ]; then
      write_atomic "$restore_pending_file" "pending" || {
        echo failed
        exit 1
      }
      run_pmset 0
      echo ok
    elif [ -f "$restore_pending_file" ]; then
      echo ok
    else
      echo none
    fi
    exit 0
    ;;
  finish-removal)
    take_lock || {
      echo failed
      exit 1
    }
    /bin/rm -f "$session_file" "$tombstone_file" "$restore_pending_file"
    echo ok
    exit 0
    ;;
  check)
    classify
    exit 0
    ;;
  repair)
    [ -f "$session_file" ] || exit 0
    take_lock || exit 0
    # Look again under the lock: the app may have ended or replaced the session meanwhile.
    state=$(classify)
    case "$state" in
      dead | stale)
        record=$(<"$session_file") || record=""
        run_pmset 0
        /bin/rm -f "$session_file"
        write_atomic "$tombstone_file" "reverted ${record%% *}" || {
          echo failed
          exit 1
        }
        echo reverted
        ;;
    esac
    exit 0
    ;;
  probe)
    { [ ! -f "$removal_file" ] && agent_loaded; } || refuse_unready
    # Two checks, both required. Listing (`sudo -l`) proves each direction, `disablesleep 0` and
    # `disablesleep 1`, is covered by a rule, so `off` and `repair` can't be denied later.
    # Listing succeeds for a rule that still wants a password, so the probe then runs the command:
    # it re-sets the current value (a no-op, nothing of another app's is changed). `-k`
    # ignores cached credentials and `-n` never prompts, so only a NOPASSWD rule gets through.
    # `pmset -a disablesleep` writes the stored value, so it only runs when the effective and
    # stored values are both known and agree, and under the lock `repair` and `off` hold so
    # neither can change them between the read and the write. Mirrors ClosedLidPermission.probe.
    take_lock 10 2 || {
      echo busy
      exit 1
    }
    for direction in 0 1; do
      detail=$(run_sudo -l /usr/bin/pmset -a disablesleep "$direction") || {
        status=$?
        # `sudo -l` exits 1 with no message when no rule covers the command.
        [ "$status" -ne 1 ] || detail="a password is required"
        report "$status" "$detail"
      }
    done
    current=$(current_sleep_disabled)
    stored=$(stored_sleep_disabled)
    case "$current" in
      0 | 1) [ "$stored" = "$current" ] || current="" ;;
    esac
    case "$current" in
      0 | 1) ;;
      *)
        echo failed
        exit 1
        ;;
    esac
    detail=$(run_sudo -k /usr/bin/pmset -a disablesleep "$current") || status=$?
    ;;
esac

if [ "$status" -eq 0 ]; then
  echo ok
  exit 0
fi
report "$status" "$detail"
